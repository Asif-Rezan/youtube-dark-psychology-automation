# Configure secrets in the cloud host, never commit real values.
GROQ_API_KEY=
STORY_MODEL=openai/gpt-oss-120b
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=troy
IMAGE_BACKEND=cpu
# Optional paid/limited-credit inference backend: IMAGE_BACKEND=hf
HF_TOKEN=
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Authorized-user OAuth JSON, obtained through Google consent outside this script.
YOUTUBE_TOKEN_JSON=
EXPECTED_CHANNEL_ID=UCYjz7d66SsshimfpxZahlhQ
# Google Drive free allowance; OAuth token with drive.file scope.
DRIVE_TOKEN_JSON=
# Owner-only folder selected/created through this OAuth app.
DRIVE_FOLDER_ID=
# Free MusicRNN music is generated on the cloud CPU runner.
# Both gates intentionally default to false. Do not enable before real test.
UPLOAD_ENABLED=false
DAILY_ENABLED=false

# Free CPU narration, alignment and AI music defaults.
TTS_BACKEND=kokoro
CPU_TTS_VOICE=am_michael
CAPTION_BACKEND=cpu
MUSIC_BACKEND=magenta

# Illustrated long-video model defaults (public weights, no inference credits).
CPU_IMAGE_MODEL=Lykon/dreamshaper-8
CPU_IMAGE_WIDTH=768
CPU_IMAGE_HEIGHT=432
CPU_IMAGE_STEPS=28
# Video: 600–900 seconds; one new image every 7 seconds.
